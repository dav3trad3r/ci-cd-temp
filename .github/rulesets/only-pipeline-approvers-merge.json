{
  "name": "Only Pipeline approvers merge",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "bypass_actors": [{ "actor_type": "Team", "actor_id": 0, "bypass_mode": "pull_request" }],
  "rules": [{ "type": "update", "parameters": { "update_allows_fetch_and_merge": false } }]
}
