# Copy to .env for local settings. Never commit .env.

# Server-only settings. Never prefix these with VITE_.
APP_JWT_SECRET=replace-with-a-long-random-value
DATABASE_URL=postgres://app:password@localhost:5432/app
BUSINESS_TIME_ZONE=Australia/Brisbane

# Afternoon platform report (npm run report). In GitHub Actions these are repository secrets.
# Optional: leave the key empty to read it from Key Vault, or use "auth": "entra" for no key at all.
TEAMS_WEBHOOK_URL=https://example.invalid/teams-workflow-webhook
ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource-name
ANTHROPIC_FOUNDRY_API_KEY=

# Browser settings. Anything starting VITE_ is readable by every visitor.
VITE_APP_NAME=CI/CD template
