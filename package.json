{
  "name": "ci-cd-temp",
  "version": "1.2.0",
  "private": true,
  "description": "A starter repo for internal tools built with AI coding assistants, with CI, security scanning and regression checks switched on from the first commit.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server/index.js",
    "db:migrate": "node dist/server/migrate.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:frontend": "node scripts/check-frontend.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:guardrails": "tsx scripts/check-guardrails.ts",
    "check:infra": "node scripts/check-infra.mjs",
    "tool": "tsx scripts/platform/cli.ts",
    "tool:selftest": "tsx scripts/platform/selftest.ts",
    "rulesets:apply": "tsx scripts/apply-rulesets.ts",
    "eval": "tsx evals/run.ts",
    "report": "tsx scripts/report/run.ts",
    "report:sample": "tsx scripts/report/run.ts --sample",
    "sre:setup": "tsx scripts/sre/setup.ts",
    "sre": "tsx scripts/sre/run.ts",
    "sre:demo": "tsx scripts/sre/run.ts --demo",
    "verify": "npm run check:guardrails && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run check:frontend && npm run check:infra && npm run smoke"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/foundry-sdk": "1.1.1",
    "@anthropic-ai/sdk": "1.12.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
