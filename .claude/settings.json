{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(gh pr merge *)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(package.json)",
      "Edit(budgets.json)",
      "Edit(evals/baseline.json)",
      "Edit(vitest.config.ts)",
      "Edit(eslint.config.js)",
      "Edit(tsconfig.json)",
      "Edit(.prettierrc.json)",
      "Edit(.prettierignore)",
      "Edit(bicepconfig.json)",
      "Edit(evals/run.ts)",
      "Edit(scripts/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(az * delete *)",
      "Bash(terraform destroy *)",
      "Bash(gh repo delete *)",
      "Bash(npm publish *)"
    ]
  }
}
