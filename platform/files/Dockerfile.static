# Generated by the platform for a browser-only tool.
# To customise it, add a Dockerfile at the repository root and set "dockerfile" in .platform/tool.json.
FROM __BASE_IMAGE__ AS build
WORKDIR /app
COPY . .
__SETUP__RUN __INSTALL__
__BUILD__

FROM nginxinc/nginx-unprivileged:1.29-alpine
COPY --from=build /app/__WEB_DIR__ /usr/share/nginx/html
EXPOSE 8080
